            <limit lower="-2.7" upper="-0.6" effort="33.5" velocity="21" />
        </joint>

        <link name="FL_foot">
            <inertial>
                <origin xyz="1.66533453693773E-16 1.04083408558608E-16 -1.11022302462516E-16" rpy="0 0 0" />
