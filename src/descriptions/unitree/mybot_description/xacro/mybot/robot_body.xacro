                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <sphere radius="0.02" />
                </geometry>
            </collision>
        </link>
        <joint name="FL_foot_fixed" type="fixed">
            <origin xyz="0.0015191 -0.00025 -0.22467" rpy="0 0 0" />
            <parent link="FL_calf" />
            <child link="FL_foot" />
            <axis xyz="0 0 0" />
        </joint>

        <link name="FR_hip">
