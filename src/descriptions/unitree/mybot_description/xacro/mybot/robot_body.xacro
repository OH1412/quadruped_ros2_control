            <origin xyz="0 0 0" rpy="0 0 0"/>
            <parent link="base"/>
            <child link="trunk"/>
        </joint>
        <link name="trunk">
            <inertial>
                <origin xyz="-0.055 0.0 -0.075" rpy="0 0 0" />
                <mass value="4.30616163" />
