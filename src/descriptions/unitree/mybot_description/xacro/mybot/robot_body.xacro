            <parent link="FL_hip" />
            <child link="FL_thigh" />
            <axis xyz="0 1 0" />
            <!-- HFE: 大腿前后摆，保持原范围 -->
            <limit lower="-1.44" upper="1.44" effort="33.5" velocity="21" />
        </joint>

        <link name="FL_calf">
            <inertial>
