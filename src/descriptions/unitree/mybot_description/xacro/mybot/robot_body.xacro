<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mybot_body">

    <!-- 引入 transmission 宏 -->
    <xacro:include filename="$(find mybot_description)/xacro/my_common/transmission.xacro"/>

    <xacro:macro name="mybot_body" params="mesh_path">
        <!-- 根链接：给插件使用的 base -->
        <link name="base"/>
        <joint name="base_to_body" type="fixed">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <parent link="base"/>
            <child link="trunk"/>
        </joint>
        <link name="trunk">
            <inertial>
                  <origin
        xyz="0.0 0.0 0.0"
        rpy="0 0 0" />
                <mass value="5.3036" />
               <inertia
                    ixx="0.012634"
                    ixy="-1.0247E-06"
                    ixz="0.002562"
                    iyy="0.017259"
                    iyz="-3.3196E-07"
                    izz="0.017164" />
                <!-- go2 对应参数: trunk_mass=6.921, trunk_com=(0.021112, 0, -0.005366),
                     inertia: ixx=0.02448, ixy=0.00012166, ixz=0.0014849, iyy=0.098077, iyz=-3.12e-05, izz=0.107 -->
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/body.STL" />
                </geometry>
                <material name="">
                    <color rgba="0.75294 0.75294 0.75294 1" />
                </material>
            </visual>
            <collision>
                <!-- go2: trunk collision box size="0.3762 0.0935 0.114" -->
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="0.3762 0.0935 0.114" />
                </geometry>
            </collision>
        </link>

        <link name="FL_hip">
            <inertial>
                <origin xyz="0.049109 0.0014996 -1.9828E-05" rpy="0 0 0" />
                <mass value="0.62455" />
                <inertia ixx="0.00051175" ixy="3.0689E-08" ixz="3.6249E-07" iyy="0.00080416" iyz="2.5347E-08" izz="0.00043104" />
                <!-- go2 对应参数: hip_mass=0.678, hip_com=(-0.0054, 0.00194, -0.000105),
                     inertia: ixx=0.00048, ixy=-3.01e-06, ixz=1.11e-06, iyy=0.000884, iyz=-1.42e-06, izz=0.000596 -->
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/FL_hip.STL" />
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1" />
                </material>
            </visual>
            <collision>
                <!-- go2: hip collision cylinder radius=0.046 length=0.04 at y=+0.0955, rpy=pi/2 0 0 -->
                <origin xyz="0 0.0955 0" rpy="1.5708 0 0" />
                <geometry>
                    <cylinder radius="0.046" length="0.04" />
                </geometry>
            </collision>
        </link>
        <joint name="FL_hip_joint" type="revolute">
            <origin xyz="0.0946 0.062 -0.071" rpy="0 0 0" />
            <parent link="trunk" />
            <child link="FL_hip" />
            <axis xyz="1 0 0" />
            <dynamics damping="0.1" friction="0.2"/>
            <limit lower="-1.0472" upper="1.0472" effort="23.7" velocity="30.1" />
        </joint>

        <link name="FL_thigh">
            <inertial>
                <origin xyz="0.00040284 0.05094 -0.044849" rpy="0 0 0" />
                <mass value="1.107" />
                <inertia ixx="0.0026249" ixy="-3.0685E-08" ixz="-3.4311E-05" iyy="0.0030336" iyz="-2.5044E-08" izz="0.00046586" />
                <!-- go2 对应参数: thigh_mass=1.152, thigh_com=(-0.00374, -0.0223, -0.0327),
                     inertia: ixx=0.00584, ixy=8.72e-05, ixz=-0.000289, iyy=0.0058, iyz=0.000808, izz=0.00103 -->
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/FL_thigh.STL" />
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1" />
                </material>
            </visual>
            <collision>
                <!-- go2: thigh collision box size="0.213 0.0245 0.034" at z=-0.1065, rpy=0 pi/2 0 -->
                <origin xyz="0 0 -0.1065" rpy="0 1.5708 0" />
                <geometry>
                    <box size="0.213 0.0245 0.034" />
                </geometry>
            </collision>
        </link>
        <joint name="FL_thigh_joint" type="revolute">
            <origin xyz="0.085 0.03295 0" rpy="0 0 0" />
            <parent link="FL_hip" />
            <child link="FL_thigh" />
            <axis xyz="0 1 0" />
            <dynamics damping="0.1" friction="0.2"/>
            <limit lower="-1.5708" upper="3.4907" effort="23.7" velocity="30.1" />
        </joint>

        <link name="FL_calf">
            <inertial>
                <origin xyz="0.0173313220834074 -3.86262616810795E-05 -0.100135269530258" rpy="0 0 0" />
                <mass value="0.292483071997453" />
                <inertia ixx="0.000903299669438753" ixy="-2.55525312562112E-11" ixz="0.000155678759259663" iyy="0.000949320326267258" iyz="1.05414825036111E-10" izz="6.30610325260309E-05" />
                <!-- go2 对应参数: calf_mass=0.154, calf_com=(0.00548, -0.000975, -0.115),
                     inertia: ixx=0.00108, ixy=3.4e-07, ixz=1.72e-05, iyy=0.0011, iyz=8.28e-06, izz=3.29e-05 -->
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/FL_calf.STL" />
                </geometry>
                <material name="">
                    <color rgba="0.847058823529412 0.847058823529412 0.847058823529412 1" />
                </material>
            </visual>
            <collision>
                <!-- go2: calf collision box size="0.213 0.016 0.016" at z=-0.1065, rpy=0 pi/2 0 -->
                <origin xyz="0 0 -0.1065" rpy="0 1.5708 0" />
                <geometry>
                    <box size="0.213 0.016 0.016" />
                </geometry>
            </collision>
        </link>
        <joint name="FL_calf_joint" type="revolute">
            <origin xyz="0 0.0705 -0.22" rpy="0 0 0" />
            <parent link="FL_thigh" />
            <child link="FL_calf" />
            <axis xyz="0 1 0" />
            <dynamics damping="0.1" friction="0.2"/>
            <limit lower="-2.7227" upper="-0.83776" effort="35.55" velocity="20.06" />
        </joint>

        <link name="FL_foot">
            <inertial>
                <origin xyz="1.66533453693773E-16 1.04083408558608E-16 -1.11022302462516E-16" rpy="0 0 0" />
                <mass value="0.0335103216382911" />
                <inertia ixx="5.36165146212658E-06" ixy="-7.94093388050967E-23" ixz="-3.17637355220363E-22" iyy="5.36165146212658E-06" iyz="1.32348898008481E-22" izz="5.36165146212658E-06" />
                <!-- go2 对应参数: foot_mass=0.06, inertia approx ixx=iyy=izz=9.6e-06 -->
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
