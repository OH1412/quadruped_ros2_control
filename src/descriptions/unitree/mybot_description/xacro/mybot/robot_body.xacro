                    <box size="0.213 0.016 0.016" />
                </geometry>
            </collision>
        </link>
        <joint name="RR_calf_joint" type="revolute">
            <origin xyz="0 -0.0705 -0.22" rpy="0 0 0" />
            <parent link="RR_thigh" />
            <child link="RR_calf" />
            <axis xyz="0 1 0" />
            <dynamics damping="0.1" friction="0.2"/>
            <limit lower="-2.7227" upper="-0.83776" effort="35.55" velocity="20.06" />
        </joint>

        <link name="RR_foot">
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="0.0335103216382911" />
                <inertia ixx="5.36165146212658E-06" ixy="-2.68773268713706E-23" ixz="-2.7811675003655E-22" iyy="5.36165146212658E-06" iyz="2.423491454722E-23" izz="5.36165146212658E-06" />
                <!-- go2 对应参数: foot_mass=0.06, inertia approx ixx=iyy=izz=9.6e-06 -->
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/RR_foot.STL" />
                </geometry>
                <material name="">
                    <color rgba="0.298039215686275 0.298039215686275 0.298039215686275 1" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <sphere radius="0.02" />
                </geometry>
            </collision>
        </link>
        <joint name="RR_foot_fixed" type="fixed">
            <origin xyz="0.0015191 0.00025 -0.22467" rpy="0 0 0" />
            <parent link="RR_calf" />
            <child link="RR_foot" />
            <axis xyz="0 0 0" />
        </joint>

        <!-- 关闭上肢部件自碰撞，防止穿模爆炸 -->
        <gazebo reference="trunk"> <self_collide>false</self_collide> </gazebo>
        <gazebo reference="FL_hip"> <self_collide>false</self_collide> </gazebo>
        <gazebo reference="FL_thigh"> <self_collide>false</self_collide> </gazebo>
        <gazebo reference="FL_calf"> <self_collide>false</self_collide> </gazebo>
        <gazebo reference="FR_hip"> <self_collide>false</self_collide> </gazebo>
        <gazebo reference="FR_thigh"> <self_collide>false</self_collide> </gazebo>
        <gazebo reference="FR_calf"> <self_collide>false</self_collide> </gazebo>
        <gazebo reference="RL_hip"> <self_collide>false</self_collide> </gazebo>
        <gazebo reference="RL_thigh"> <self_collide>false</self_collide> </gazebo>
        <gazebo reference="RL_calf"> <self_collide>false</self_collide> </gazebo>
        <gazebo reference="RR_hip"> <self_collide>false</self_collide> </gazebo>
        <gazebo reference="RR_thigh"> <self_collide>false</self_collide> </gazebo>
        <gazebo reference="RR_calf"> <self_collide>false</self_collide> </gazebo>

        <!-- Gazebo contact parameters for feet -->
        <gazebo reference="FL_foot">
            <mu1>0.6</mu1>
            <mu2>0.6</mu2>
            <self_collide>1</self_collide>
            <material>Gazebo/DarkGrey</material>
            <kp value="200000.0"/>
            <kd value="100.0"/>
        </gazebo>
        <gazebo reference="FR_foot">
            <mu1>0.6</mu1>
            <mu2>0.6</mu2>
            <self_collide>1</self_collide>
            <material>Gazebo/DarkGrey</material>
            <kp value="200000.0"/>
            <kd value="100.0"/>
        </gazebo>
        <gazebo reference="RL_foot">
            <mu1>0.6</mu1>
            <mu2>0.6</mu2>
            <self_collide>1</self_collide>
            <material>Gazebo/DarkGrey</material>
            <kp value="200000.0"/>
            <kd value="100.0"/>
        </gazebo>
        <gazebo reference="RR_foot">
            <mu1>0.6</mu1>
            <mu2>0.6</mu2>
            <self_collide>1</self_collide>
            <material>Gazebo/DarkGrey</material>
            <kp value="200000.0"/>
            <kd value="100.0"/>
        </gazebo>

        <!-- Transmissions - 使用宏定义 -->
        <xacro:leg_transmission name="FL"/>
        <xacro:leg_transmission name="FR"/>
        <xacro:leg_transmission name="RL"/>
        <xacro:leg_transmission name="RR"/>

    </xacro:macro>
</robot>