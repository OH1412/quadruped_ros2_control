<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mybot_body">

    <xacro:include filename="$(find mybot_description)/xacro/my_common/transmission.xacro"/>

    <xacro:macro name="mybot_body" params="mesh_path">
        <link name="base"/>
