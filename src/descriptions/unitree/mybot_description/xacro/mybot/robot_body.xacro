<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mybot_body">

    <!-- 引入 transmission 宏 -->
    <xacro:include filename="$(find mybot_description)/xacro/my_common/transmission.xacro"/>

    <xacro:macro name="mybot_body" params="mesh_path">
        <!-- 根链接：给插件使用的 base -->
        <link name="base"/>
        <joint name="base_to_body" type="fixed">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <parent link="base"/>
            <child link="body"/>
        </joint>
        <link name="body">
            <inertial>
                  <origin
        xyz="-0.075044 0.0013153 0.023062"
        rpy="0 0 0" />
                <mass value="5.3036" />
               <inertia
        ixx="0.012634"
        ixy="-1.0247E-06"
        ixz="0.002562"
        iyy="0.017259"
        iyz="-3.3196E-07"
        izz="0.017164" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/body.STL" />
                </geometry>
                <material name="">
                    <color rgba="0.75294 0.75294 0.75294 1" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/body.STL" />
                </geometry>
            </collision>
        </link>

        <link name="FL_hip">
            <inertial>
                <origin xyz="0.049109 0.0014996 -1.9828E-05" rpy="0 0 0" />
                <mass value="0.62455" />
                <inertia ixx="0.00051175" ixy="3.0689E-08" ixz="3.6249E-07" iyy="0.00080416" iyz="2.5347E-08" izz="0.00043104" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/FL_hip.STL" />
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/FL_hip.STL" />
                </geometry>
            </collision>
        </link>
        <joint name="FL_hip_joint" type="revolute">
            <origin xyz="0.0946 0.062 -0.071" rpy="0 0 0" />
            <parent link="body" />
            <child link="FL_hip" />
            <axis xyz="1 0 0" />
            <!-- HAA: 侧摆关节，保持原范围 -->
            <limit lower="-0.48" upper="0.48" effort="33.5" velocity="21" />
        </joint>

        <link name="FL_thigh">
            <inertial>
                <origin xyz="0.00040284 0.05094 -0.044849" rpy="0 0 0" />
                <mass value="1.107" />
                <inertia ixx="0.0026249" ixy="-3.0685E-08" ixz="-3.4311E-05" iyy="0.0030336" iyz="-2.5044E-08" izz="0.00046586" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/FL_thigh.STL" />
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1" />
